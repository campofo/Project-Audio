[Unit]
Description=Forest Defense Audio Node API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/forest-defense-audio
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/forest-defense-audio/.venv/bin/uvicorn forest_defense.api:app --factory --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
User=pi
Group=pi

[Install]
WantedBy=multi-user.target
